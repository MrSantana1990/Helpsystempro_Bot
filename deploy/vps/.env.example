# ===== DOMÍNIO (Caddy) =====
DOMAIN=bot.exemplo.com

# ===== AUTH (Caddy basic auth) =====
# Gere o hash com: caddy hash-password --plaintext "SENHA"
PANEL_USER=admin
PANEL_PASSWORD_HASH=$2a$14$REPLACE_ME

# ===== APP =====
HSP_PORTAL_TOKEN=REPLACE_ME_TOKEN_LONGO

# Recomendações:
# - Em VPS, desabilite Local-only e exija auth por token no /api
HSP_LOCAL_ONLY=0
ENABLE_AUTH=1

# 2FA ainda não implementado como auth de login; flag reservada
ENABLE_2FA=0

# Live trading trava (só habilite após piloto + licença + termo)
HSP_LIVE_TRADING=0

# Autostart 24/7 (recomendado na VPS)
HSP_AUTOSTART_BOT=1
# Por segurança, autostart em dry-run (simulação/análise)
HSP_AUTOSTART_DRY_RUN=1
