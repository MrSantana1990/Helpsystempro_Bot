# Domínio deste cliente
TENANT_DOMAIN=cliente1.seudominio.com

# Basic auth (Traefik). Gere e já escape o "$" (vira "$$") usando:
#   bash deploy/vps_multi/bin/gen-basicauth.sh admin "SENHA_FORTE"
# Cole o resultado (user:hash) abaixo:
TENANT_BASIC_AUTH=admin:$$apr1$$REPLACE_ME_HASH

# Token do portal (protege start/stop/config e endpoints /api quando ENABLE_AUTH=1)
HSP_PORTAL_TOKEN=REPLACE_ME_TOKEN_LONGO

# Cloud flags
HSP_LOCAL_ONLY=0
ENABLE_AUTH=1
ENABLE_2FA=0
HSP_LIVE_TRADING=0

# Autostart 24/7 (recomendado na VPS)
HSP_AUTOSTART_BOT=1
# Por segurança, autostart em dry-run (simulação/análise)
HSP_AUTOSTART_DRY_RUN=1
